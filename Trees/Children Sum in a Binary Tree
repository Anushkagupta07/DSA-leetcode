class Solution {
  public:
    bool isSumProperty(Node *root) {
        // code here
        if(root == NULL){
            return true;
        }
        if(root->left == NULL && root->right == NULL){
            return true;
        }
        int l=0;
        int r=0;
        if(root->left){
            l = root->left->data;
        }
        if(root->right){
            r = root->right->data;
        }
        if(root->data!= l + r){
            return false;
        }
        return isSumProperty(root->left) && isSumProperty(root->right);
    }
};
//t.c. = O(n)
//s.c. = O(n)
