class Solution {
public:
    int dfs(TreeNode* root, int max_val){
        if(root == NULL){
            return 0;
        }
        int count = 0;
        if(root->val >= max_val){
            count = 1;
        }
        max_val = max(max_val , root->val);
        count+= dfs(root->left , max_val);
        count+= dfs(root->right , max_val);
        return count;
    }
    int goodNodes(TreeNode* root) {
       return dfs(root , root->val); 
    }
};
//t.c. = O(n)
//s.c. = O(h)
