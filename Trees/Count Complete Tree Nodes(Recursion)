class Solution {
public:
    int countNodes(TreeNode* root) {
    if(root == NULL){
        return 0;
    }    
    int leftcount = countNodes(root->left);
    int rightcount = countNodes(root->right);
    return 1 + leftcount + rightcount;
    }
};
//t.c. = O(n)
//s.c. = O(h) where h is height of the binary tree
