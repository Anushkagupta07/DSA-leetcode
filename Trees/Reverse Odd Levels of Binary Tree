class Solution {
public:
    TreeNode* reverseOddLevels(TreeNode* root) {
    if(root == NULL) return NULL;
    queue<TreeNode*>q;
    q.push(root);
    int level = 0;
    while(!q.empty()){
        vector<TreeNode*> nodes;
        int n = q.size();
        for(int i=0;i<n;i++){
        TreeNode* curr = q.front();
        nodes.push_back(curr);
        q.pop();
        if(curr->left){
            q.push(curr->left);
        }
        if(curr->right){
            q.push(curr->right);
        }
        }
        if(level%2 == 1){
            int l = 0;
            int r = n-1;
            while(l<r){
                swap(nodes[l]->val , nodes[r]->val);
                l++;
                r--;
            }
        }
        level++;
    }
    return root;
    }
};
//t.c. = O(n)
//s.c. = O(n), queue and vector
