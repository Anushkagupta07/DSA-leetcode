class Solution {
public:
    int divide(int dividend, int divisor) {
        //BRUTE FORCE APPROACH
    //we can make a variable count and add d until n>=d and increase the count and after while loop make return count
    if(dividend == divisor){
        return 1;
    }  
    bool sign = true;
    if(dividend >= 0 && divisor <=0){
        sign = false;
    }
    if(dividend <= 0 && divisor >= 0){
        sign = false;
    }
    long long n = llabs(dividend);
    long long d = llabs(divisor);
    long long quotient = 0;
    while(n >= d){
        int count = 0;
        while(n >= (d << count+1)){
            count+=1;
        }
        quotient += 1LL << count;
        n-= (d << count);
    }
    if(quotient == (1LL << 31) && sign){
        return INT_MAX;
    }
    if(quotient == (1LL << 31) && !sign){
        return INT_MIN;
    }
    if(sign == true) return quotient;
    else return -quotient;
   }
};
//t.c. = O(logbase2(n))^2
//s.c. = O(1)

