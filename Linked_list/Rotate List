class Solution {
public:
    ListNode* rotateRight(ListNode* head, int k) {
    if(head == NULL || head->next == NULL){
        return head;
    }
    int len = 0;
    ListNode* curr = head;
    while(curr != NULL){
        len++;
        curr = curr->next;
    }
    int count = 1;
    ListNode* prev = NULL;
    curr = head;
    k = k % len;
    if(k == 0) return head;
    while(curr != NULL && count != len-k){
        prev = curr;
        curr = curr->next;
        count++;
    }
    ListNode* newHead = curr->next;
    ListNode* temp = curr;
    while(temp != NULL && temp->next != NULL){
        temp = temp->next;
    }
    temp->next = head;
    curr->next = NULL;
    return newHead;
    }
};
//t.c. = O(n)
//s.c. = O(1)
