class Solution {
  public:
    Node* removeDuplicates(Node* head) {
        // code here
        Node* dummy = new Node(-1);
        dummy->next = head;
        Node* prev = dummy;
        Node* curr = head;
        unordered_set<int>s;
        while(curr != NULL){
            if(s.find(curr->data) == s.end()){
                s.insert(curr->data);
                prev = curr;
                curr = curr->next;
            }else{
                prev->next = curr->next;
                curr = curr->next;
            }
        }
        return dummy->next;
    }
};
//t.c. = O(n)
//s.c. = O(n)
