class Solution {
public:
    ListNode* mergeTwoLists(ListNode* list1, ListNode* list2) {
        ListNode* dummy = new ListNode(-1);
        ListNode* temp = dummy;
        if(list1 == NULL) return list2; 
        if(list2 == NULL) return list1;
        while(list1 != NULL && list2 != NULL){
        if(list1->val >= list2->val){
            temp->next = list2;
            temp = list2;
            list2 = list2->next;
        } else{
            temp->next = list1;
            temp = list1;
            list1 = list1->next;
        }
        }
        if(list1 != NULL){
            temp->next= list1;
        }else{
            temp->next = list2;
        }
        return dummy->next;
    }
};
//t.c. = O(m+n) m->length of list1 and n->length of list2
//s.c. = O(1)
