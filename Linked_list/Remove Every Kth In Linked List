class Solution {
  public:
    Node* deleteK(Node* head, int K) {
        // code here
        Node* dummy = new Node(-1);
        dummy->next = head;
        Node* prev = dummy;
        Node* curr = head;
        int count = 1;
        while(curr != NULL){
            if(count == K){
                prev->next = curr->next;
                curr = curr->next;
                count = 1;
            }else{
                prev = curr;
                curr = curr->next;
                count++;
            }
        }
        return dummy->next;
    }
};
//t.c. = O(n)
//s.c. = O(1)
