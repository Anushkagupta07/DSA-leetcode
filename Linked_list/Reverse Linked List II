class Solution {
public:
    ListNode* reverseBetween(ListNode* head, int left, int right) {
    ListNode* dummy = new ListNode(-1);
    dummy->next = head;
    ListNode* prev = dummy;
    ListNode* curr = head;
    int count = 1;
    while(curr!= NULL && count!=left){
        prev = curr;
        curr = curr->next;
        count++;
    }
    count = 0;
    ListNode* first = prev;
    ListNode* second = curr;
    while(curr != NULL && count != right-left+1){
        ListNode* next = curr->next;
        curr->next = prev;
        prev = curr;
        curr = next;
        count++;
    }
    first->next = prev;
    second->next = curr;
    return dummy->next;
    }
};
//t.c. = O(n)
//s.c. = O(1)
