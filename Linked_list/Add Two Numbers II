class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
    stack<int>s1;
    ListNode* curr = l1;
    while(curr != NULL){
        s1.push(curr->val);
        curr = curr->next;
    }
    stack<int>s2;  
    curr = l2;
    while(curr != NULL){
        s2.push(curr->val);
        curr = curr->next;
    }  
    int carry = 0;
    ListNode* newHead = NULL;
    while(!s1.empty() || !s2.empty() || carry != 0){
        int digit1 = 0;
        int digit2 = 0;
        if(!s1.empty()){
        digit1 = s1.top();
        s1.pop();
        }
        if(!s2.empty()){
        digit2 = s2.top();
        s2.pop();
        }
        int sum  = digit1 + digit2 + carry;
        int digit = sum % 10 ;
        carry = sum/10;
        ListNode* newNode = new ListNode(digit);
        newNode->next = newHead;
        newHead = newNode;
    }
    return newHead;
    }
};
//t.c. = O(m+n)
//s.c. = O(m+n)
