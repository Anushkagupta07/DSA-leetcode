class Solution {
public:
    int smallestIndex(vector<int>& nums) {
    int n = nums.size();
    for(int i=0;i<n;i++){
        int currsum  = 0;
        int x = nums[i];
        while(x > 0){
            currsum+= x%10;
            x = x/10;
        }
        if(currsum == i){
            return i;
        }
    }   
    return -1;
    }
};
//t.c. = O(n*4) => O(n)
//s.c. = O(1)
