class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int n = nums.size();
        if(n < k){
        return 0;
        }
        double sum = 0;
        double maxavg = 0;
        for(int i = 0;i < k;i++){
            sum += nums[i];
        }
        maxavg = sum*1.0/k;
        for(int i = k;i < n;i++) {
            sum+= nums[i] - nums[i-k];
            maxavg = max(maxavg,sum*1.0/k);
        }
        return maxavg;
    }
};
//t.c. = O(n)
//s.c. = O(1)
