class Solution {
public:
    int minSubArrayLen(int target, vector<int>& nums) {
    int n = nums.size();
    int min_val = INT_MAX;
    int sum = 0;
    int left = 0;
    for(int i=0;i<n;i++){
        sum+= nums[i];
       while(sum >= target){
        min_val = min(min_val , i-left+1);
        sum -= nums[left];
        left++;
       }
    }   
    if(min_val == INT_MAX) return 0;
    else return min_val; 
    }
};
//t.c. = O(n)
//s.c. = O(1)
