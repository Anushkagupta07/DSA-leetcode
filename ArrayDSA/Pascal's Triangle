class Solution {
public:
    vector<vector<int>> generate(int numRows) {
    vector<vector<int>>result;
    for(int row=1; row<=numRows;row++){
        long long ans = 1;
        vector<int>temp;
        temp.push_back(ans);
        for(int col = 1; col<row;col++){
            ans = ans * (row-col) / (col);
            temp.push_back(ans);
        }
        result.push_back(temp);
    }   
    return result;
    }
};
//t.c. = O(n^2)
//s.c. = O(n), only auxiliary space
