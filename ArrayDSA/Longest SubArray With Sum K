class Solution {
  public:
    int longestSubarray(vector<int>& arr, int k) {
    int n = arr.size();
        map<int,int>mp;
        int sum = 0;
        int maxlen = 0;
        for(int i=0;i<n;i++){
           sum+= arr[i]; 
           if(sum == k){
               maxlen = max(maxlen , i+1);
           }
           int rem = sum-k;
           if(mp.find(rem) != mp.end()){
               int len = i - mp[rem];
               maxlen = max(maxlen , len);
           }
           if(mp.find(sum) == mp.end()){
               mp[sum] = i;
           }
        }
        return maxlen;
    }
};
