class Solution {
public:
    int waysToSplitArray(vector<int>& nums) {
    int n = nums.size();
    long long total_sum = 0;
    long long prefix_sum = 0;
    int count = 0;
    for(int i=0;i<n;i++){
        total_sum+= nums[i];
    }    
    for(int i=0;i<n-1;i++){
        prefix_sum += nums[i];
        long long suffix_sum = total_sum - prefix_sum;
        if(prefix_sum >= suffix_sum){
            count++;
        }
    }
    return count;
    }
};
//t.c. = O(2n) => O(n)
//s.c. = O(1)
