
class Solution {
public:
    void setZeroes(vector<vector<int>>& matrix) {
    //BRUTE FORCE APPROACH
    //for every element as 0, mark its rows and columns as -1 and then again iterate once again on whole matrix and convert -1 to 0.
    //t.c. = O(n*m)*O(n+m) + O(n*m), somewhere in the power of cube.
    //s.c. = O(1)    



    //BETTER APPROACH
    int m = matrix.size(); //rows
    int n = matrix[0].size(); //columns
    vector<int>col(n, 0);
    vector<int>row(m, 0);
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(matrix[i][j] == 0){
                row[i] = 1;
                col[j] = 1;
            }
        }
    }
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(row[i] || col[j]){
                matrix[i][j] = 0;
            }
        }
    }
    }
};
t.c. = O(2*n*m)
s.c. = O(n) + O(m)



//OPTIMISED APPROACH
int n = matrix.size(); //rows
int m = matrix[0].size(); //columns
int col0 = 1;
for(int i=0;i<n;i++){
    for(int j=0;j<m;j++){
        if(matrix[i][j] == 0){
            matrix[i][0] = 0;
            if(j != 0){
                matrix[0][j] = 0;
            }else{
                col0 = 0;
            }
        }
    }
}
for(int i=1;i<n;i++){
    for(int j=1;j<m;j++){
        if(matrix[i][j] != 0){
            if(matrix[0][j] == 0 || matrix[i][0] == 0){
                matrix[i][j] = 0;
            }
        }
    }
}
if(matrix[0][0] == 0){
    for(int j = 0;j<m;j++){
        matrix[0][j] = 0;
    }
}
if(col0 == 0){
    for(int i=0;i<n;i++){
        matrix[i][0] = 0;
    }
}
    }
};
//t.c. = O(2*n*m)
//s.c. = O(1)
