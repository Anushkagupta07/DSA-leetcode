class Solution {
public:
    int pivotIndex(vector<int>& nums) {
        int n = nums.size();
        int total_sum = 0;
        int prefix_sum = 0;
        for(int i:nums){
            total_sum+= i;
        }  
        for(int i=0;i<n;i++){
            int suffix_sum = total_sum-prefix_sum-nums[i];
            if(prefix_sum==suffix_sum){
                return i;
            }else{
                prefix_sum+=nums[i];
            }
        }
        return -1;
  }
};
//t.c. = O(2n) => O(n)
//s.c. = O(1)
