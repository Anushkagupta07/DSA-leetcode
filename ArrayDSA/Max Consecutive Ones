class Solution {
public:
    int findMaxConsecutiveOnes(vector<int>& nums) {
    int n = nums.size();
    int sum = accumulate(nums.begin(),nums.end(),0);
    if(sum==0) return 0;
    int maxval = INT_MIN;
    int count = 0;
    for(int i=0;i<n;i++){
       if(nums[i]==1){
        count++;
        maxval = max(maxval, count);
       } else{
        count = 0;
       }
    }  
    return maxval;
    }
};
//t.c. = O(n)
//s.c. = O(1)
