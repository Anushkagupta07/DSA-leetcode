class Solution {
public:
    vector<int> targetIndices(vector<int>& nums, int target) {
    sort(nums.begin() , nums.end());
    int n = nums.size();
    vector<int>ans;
    if(n == 0) return ans;
    for(int i=0;i<n;i++){
        if(nums[i] == target){
            ans.push_back(i);
        }
    } 
    return ans;   
    }
};
//t.c. = O(nlogn)
//s.c. = O(target indices), in worst case it will be O(n).
