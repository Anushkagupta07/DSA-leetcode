class Solution {
  public:
    int findTarget(vector<int>& arr, int target) {
        // code here
        int n = arr.size();
        int s= 0;
        int e = n-1;
        while(s <= e){
            int mid = s+(e-s)/2;
            if(arr[mid] == target){
                return mid;
            }else if(mid-1 >= 0 && arr[mid-1] == target){
                return mid-1;
            }else if(mid+1 <= n && arr[mid+1] == target){
                return mid+1;
            }else if(arr[mid] > target){
                e = mid-2;
            }else{
                s = mid+2;
            }
        }
        return -1;
    }
};
//t.c. = O(logn)
//s.c. = O(1)
