class Solution {
public:
    vector<string> createGrid(int m, int n) {
    vector<string>grid(m , string(n , '#'));
    vector<string>ans;
    for(int j=0;j<n;j++){
        grid[0][j] = '.';
    }
    for(int i=0;i<m;i++){
        grid[i][n-1] = '.';
    }
    return grid;
    }
};
//t.c. = O(m*n)
//s.c. = O(m*n)
