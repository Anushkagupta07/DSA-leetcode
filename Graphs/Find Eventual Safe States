class Solution {
private:
    bool dfs(int node , vector<vector<int>>&graph , vector<int>&vis , vector<int>&pathVis , vector<int>&check){
        vis[node] = 1;
        pathVis[node] = 1;
        check[node] =0;
        for(auto it : graph[node]){
            if(!vis[it]){
                if(dfs(it , graph , vis , pathVis , check) == true){
                    check[node] = 0;
                    return true;
                }
            }else if(pathVis[it]){
                check[node] = 0;
                return true;
            }
        }
        check[node] = 1;
        pathVis[node] = 0;
        return false;
    }
public:
    vector<int> eventualSafeNodes(vector<vector<int>>& graph) {
    //anyone who is a part of a cycle cannot be a safe node.
    //anyone who leads to a cycle cannot be a safe node.
    int V = graph.size();
    vector<int>vis(V, 0);
    vector<int>pathVis(V , 0);
    vector<int>check(V , 0);
    vector<int>safeNodes; //output array
    for(int i=0;i<V;i++){
        if(!vis[i]){
            dfs(i , graph , vis , pathVis , check);
        }
    }     
    for(int i=0;i<V;i++){
        if(check[i] == 1){ //it is a safe node
            safeNodes.push_back(i);
        }
    }
    return safeNodes;
    }
};
//t.c. = O(V+E)
//s.c. = O(3n), however we can do in a single array by using counter 1 , 2 , 3 but that will decrease readibility.
