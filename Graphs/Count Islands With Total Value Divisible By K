class Solution {
private:
    void dfs(int row , int col , vector<vector<int>>&grid , vector<vector<int>>&vis , long long& sum){
        int m = grid.size();
        int n = grid[0].size();
        vis[row][col] = 1;
        sum+= grid[row][col];
        int delrow[] = {-1 , 0 , +1 , 0};
        int delcol[] = {0 , +1 , 0 , -1};
        for(int i=0;i<4;i++){
            int nrow = row + delrow[i];
            int ncol = col + delcol[i];
            if(nrow >= 0 && nrow < m && ncol >= 0 && ncol < n && grid[nrow][ncol] != 0 && !vis[nrow][ncol]){
                dfs(nrow , ncol , grid , vis , sum);
            }
        }
    }
public:
    int countIslands(vector<vector<int>>& grid, int k) {
    int m = grid.size();
    int n = grid[0].size();
    int ans = 0;
    vector<vector<int>>vis(m , vector<int>(n,0));
    for(int i=0;i<m;i++){
        for(int j=0;j<n;j++){
            if(grid[i][j] != 0 && !vis[i][j]){
                long long sum = 0;
                dfs(i, j , grid , vis, sum);
                if(sum % k == 0){
                    ans+= 1;
                }
            }
        }
    }
    return ans;
    }
};
//t.c. = O(n*m)
//s.c. = O(n*m)
