class Solution {
private:
    void bfs(int row , int col , vector<vector<int>>&vis , vector<vector<char>>&grid){
        vis[row][col] = 1;
        queue<pair<int,int>>q;
        q.push({row, col});
        int n = grid.size();
        int m = grid[0].size();
        while(!q.empty()){
            int row = q.front().first;
            int col = q.front().second;
            q.pop();

            //traverse neighbours of particular element
            for(int delrow = -1; delrow<=1; delrow++){ // for every ele. will check its 8 neighbours.
                for(int delcol = -1; delcol<=1; delcol++){
                     if(abs(delrow) + abs(delcol) != 1)
                        continue;
                    int nrow = row + delrow;
                    int ncol = col + delcol;
                    if(nrow>=0 && nrow<n && ncol>=0 && ncol<m && grid[nrow][ncol] == '1' && !vis[nrow][ncol]){
                        vis[nrow][ncol] = 1;
                        q.push({nrow , ncol});
                    }
                }
            }
        }
    }
public:
    int numIslands(vector<vector<char>>& grid) {
    int n = grid.size();
    int m = grid[0].size();
    vector<vector<int>>vis(n, vector<int>(m,0));
    int count = 0;
    for(int row = 0; row<n; row++){ //O(n^2)
        for(int col = 0; col<m; col++){
            if(!vis[row][col] && grid[row][col] == '1'){
                count++;
                bfs(row , col , vis , grid); //will be called 3 times here as no. of islands in example 1 is 3, worst case can be n^2 when all the elements of grid are 1.
            }
        }
    }   
    return count; 
    }
};
//t.c. = O(n^2) + O(n^2)*8 => O(n^2)
//s.c. = O(n^2) + O(n^2) =>O(n^2), visited matrix and queue
